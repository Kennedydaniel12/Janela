{
  "manifest_version": 3,
  "name": "Janela — Detecção de vídeo",
  "description": "Informa ao Janela quando um vídeo está avançando na aba em foco.",
  "version": "0.1.0",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["video.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
